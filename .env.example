# Copy this file to .env before running `docker-compose up` or the manual setup.
# Every value has a working default in config.py -- you only need to set what you
# want to change. docker-compose.yml reads .env automatically from the project root.

# ---------------------------------------------------------------------------
# Storage paths (inside the backend container / your local checkout)
# ---------------------------------------------------------------------------
DATABASE_PATH=/app/bitbrain.db
GRAPH_PATH=/app/pipeline/graph.gpickle
MODEL_DIR=/app/pipeline/models
FEATURES_PATH=/app/pipeline/features.csv
RAW_DATA_DIR=/app/data/raw
METRICS_PATH=/app/docs/model_metrics.json

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list, e.g. "http://localhost:8080,http://192.168.1.50:8080"
CORS_ORIGINS=*
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=8080

# ---------------------------------------------------------------------------
# Risk scoring (pipeline/train.py) -- must sum to 1.0 to keep risk_score on a 0-100 scale
# ---------------------------------------------------------------------------
RISK_WEIGHT_SUPERVISED=0.65
RISK_WEIGHT_ANOMALY=0.35

# Thresholds used by /api/overview to bucket entities into tiers.
# Keep these in sync with VITE_RISK_TIER_HIGH / VITE_RISK_TIER_MEDIUM in frontend/.env
RISK_TIER_HIGH=70
RISK_TIER_MEDIUM=40

# ---------------------------------------------------------------------------
# Synthetic dataset generator (data/generate_synthetic_data.py)
# Only relevant if you regenerate synthetic data instead of supplying real exports.
# ---------------------------------------------------------------------------
SYNTH_SEED=42
SYNTH_N_LICIT_ENTITIES=120
SYNTH_N_ILLICIT_ENTITIES=25

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
GRAPH_MAX_SUBGRAPH_NODES=300
ALERTS_DEFAULT_LIMIT=50
