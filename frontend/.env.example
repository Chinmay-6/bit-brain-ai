# Copy to .env before `npm run dev` / `npm run build` if you need non-default values.
# Vite only exposes variables prefixed VITE_ to the browser bundle -- these are baked
# in at BUILD time, not read at container runtime (that's why docker-compose passes
# them as build args, see docker-compose.yml + frontend/Dockerfile).

# Base path the frontend calls for the API. Leave as /api for the Docker/nginx setup
# (nginx proxies /api -> the backend container). For `npm run dev`, Vite's own proxy
# in vite.config.js already forwards /api to BACKEND_PORT, so the default works there too.
VITE_API_BASE_URL=/api

# Must match RISK_TIER_HIGH / RISK_TIER_MEDIUM in the root .env -- these only control
# the color thresholds in the UI, not any scoring logic.
VITE_RISK_TIER_HIGH=70
VITE_RISK_TIER_MEDIUM=40
